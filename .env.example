NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=
JWT_ACCESS_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
VITE_API_URL=/api
ALLOW_DEV_SEED=false
ALLOW_DEMO_CATALOG_APPEND=false
# Cloudinary credentials are backend-only; leave example values empty.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
TRUST_PROXY=0
ALLOW_CREATE_INDEXES=false

# Explicit maintenance opt-in for stale/unreferenced MarketHub uploads.
ALLOW_MEDIA_CLEANUP=false
# Optional recipient for the explicit real-email delivery test.
SMTP_TEST_TO=
